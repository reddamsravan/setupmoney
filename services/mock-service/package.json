{
  "name": "@setupmoney/mock-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown src/index.ts src/node.ts --no-dts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mswjs/http-middleware": "^0.10.3",
    "msw": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "catalog:",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
